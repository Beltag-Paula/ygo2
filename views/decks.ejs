<!DOCTYPE html><html lang="en"><head><title>My Decks — YGO 2.0</title><%- include('partials/head') %></head>
<body><div class="page">
<%- include('partials/nav', { page }) %>
<h1 class="title">My Decks</h1>
<p class="sub">Your decks live in your account. Upload a <b>.ydk</b> from <a href="https://ygoprodeck.com/" target="_blank" rel="noopener" style="color:var(--gold-hi)">ygoprodeck.com</a>, or build one in the <a href="/builder" style="color:var(--gold-hi)">Deck Builder</a>. <span class="mode-chip">CLASSIC</span> = only cards from the 2002–2008 pool, <span class="mode-chip modern">MODERN</span> = every card.</p>
<div class="deck-layout">
  <div class="deck-grid" id="grid"></div>
  <div class="panel panel-pad detail" id="detail"><p class="sub">Select a deck to see its cards.</p></div>
</div>

<div class="modal-back" id="uploadModal"><div class="panel modal">
  <h3>Upload a .ydk deck</h3>
  <div class="field"><label>Deck name (optional)</label><input type="text" id="upName" maxlength="60" placeholder="Defaults to the file name"></div>
  <div class="field"><label>.ydk file</label><input type="file" id="upFile" accept=".ydk,text/plain"></div>
  <div class="field"><label>Mode</label><select id="upMode"><option value="auto">Auto-detect (Classic if every card is allowed)</option><option value="classic">Classic (leave out cards that are not allowed)</option><option value="modern">Modern</option></select></div>
  <div class="row-end"><button class="btn ghost small" id="upCancel">Cancel</button><button class="btn small" id="upGo">Upload</button></div>
</div></div>

<div class="modal-back" id="noticeModal"><div class="panel modal">
  <h3 id="ntTitle">Some cards are not available</h3>
  <p class="sub" id="ntSub" style="margin-bottom:10px"></p>
  <div class="card-list" id="ntList" style="max-height:260px"></div>
  <div class="row-end"><button class="btn small" id="ntOk">OK</button></div>
</div></div>

<div class="modal-back" id="renameModal"><div class="panel modal">
  <h3>Rename deck</h3>
  <div class="field"><input type="text" id="rnName" maxlength="60"></div>
  <div class="row-end"><button class="btn ghost small" id="rnCancel">Cancel</button><button class="btn small" id="rnGo">Save</button></div>
</div></div>

<script>
let decks = [], sel = null;
const $ = id => document.getElementById(id);
async function load() {
  decks = (await api('/api/decks')).decks;
  const g = $('grid'); g.innerHTML = '';
  decks.forEach(d => {
    const el = document.createElement('div'); el.className = caseClass(d) + (sel === d.id ? ' sel' : '');
    el.innerHTML = deckCaseHTML(d); el.onclick = () => { sel = d.id; load(); showDetail(d.id); }; g.appendChild(el);
  });
  const add = document.createElement('div'); add.className = 'deck-case add'; add.id = 'upload';
  add.innerHTML = '<div><div class="plus">+</div><b>UPLOAD .YDK</b></div>'; add.onclick = () => $('uploadModal').classList.add('on'); g.appendChild(add);
  const nw = document.createElement('a'); nw.className = 'deck-case add'; nw.href = '/builder?new=1';
  nw.innerHTML = '<div><div class="plus">✦</div><b>BUILD NEW DECK</b></div>'; g.appendChild(nw);
  if (!sel && decks[0]) { sel = decks[0].id; load(); showDetail(sel); }
}
async function showDetail(id) {
  const d = await api('/api/decks/' + encodeURIComponent(id)); const sum = decks.find(x => x.id === id) || {};
  const rows = list => list.map(c => '<div class="card-row"><img src="' + esc(c.image || '') + '" loading="lazy" onerror="this.style.visibility=\'hidden\'">' +
    '<div><div class="n">' + esc(c.name) + '</div><div class="t">' + esc(c.type) + (c.level ? ' · Lv ' + c.level : '') + (c.atk != null ? ' · ' + c.atk + '/' + (c.def ?? '?') : '') + '</div></div>' +
    '<span class="s ' + c.script.status + '" title="' + esc(c.script.note || c.script.kinds.join(', ') || '') + '">' + ({vanilla:'VANILLA',scripted:'SCRIPTED',partial:'PARTIAL',stub:'NO SCRIPT'})[c.script.status] + '</span><span class="x">×' + c.copies + '</span></div>').join('');
  const cov = sum.script;
  $('detail').innerHTML =
    '<div class="who">' + (sum.portrait ? '<span class="av-mini">' + avatarHTML(sum.portrait, sum.frame, sum.ownerName) + '</span>' : '') + '<div><h2>' + esc(d.name) + '</h2>' + (sum.ownerName ? '<div class="sub" style="margin:0;color:var(--gold)">STYLE OF ' + esc(sum.ownerName.toUpperCase()) + '</div>' : '') + '</div></div><div class="sub" style="margin:0">' + d.counts.main + ' main · ' + d.counts.extra + ' extra · ' + d.counts.side + ' side</div>' +
    '<div class="stats"><span class="mode-chip ' + (d.mode === 'modern' ? 'modern' : '') + '">' + d.mode.toUpperCase() + '</span>' + (d.errors || []).map(w => '<span class="chip low">' + esc(w) + '</span>').join('') + (cov ? '<span class="chip ' + (cov.pct >= 85 ? 'ok' : cov.pct >= 50 ? 'mid' : 'low') + '">' + cov.pct + '% SCRIPTED (' + (cov.vanilla + cov.scripted + cov.partial) + '/' + cov.total + ')</span>' : '') +
    (d.warnings || []).map(w => '<span class="chip mid">' + esc(w) + '</span>').join('') + '</div>' +
    '<div class="row-end" style="justify-content:flex-start;margin:0 0 6px">' + (d.valid ? '<a class="btn small" href="/duel?deck=' + encodeURIComponent(id) + '">Duel with this</a>' : '<span class="chip low">Not legal yet</span>') +
    '<a class="btn ghost small" href="/api/decks/' + encodeURIComponent(id) + '/export">Export .ydk</a><a class="btn ghost small" href="/builder?deck=' + encodeURIComponent(id) + '">' + 'Edit cards' + '</a><button class="btn ghost small" onclick="rename()">Rename</button><button class="btn danger small" onclick="del()">Delete</button></div>' +
    '<div class="sec">MAIN DECK</div><div class="card-list">' + rows(d.main) + '</div>' +
    (d.extra.length ? '<div class="sec">EXTRA DECK</div><div class="card-list">' + rows(d.extra) + '</div>' : '') +
    (d.side.length ? '<div class="sec">SIDE DECK</div><div class="card-list">' + rows(d.side) + '</div>' : '');
}
function notice(title, sub, list) {
  $('ntTitle').textContent = title; $('ntSub').textContent = sub;
  $('ntList').innerHTML = list.map(u => '<div class="card-row" style="grid-template-columns:1fr auto"><div><div class="n">' + esc(u.name || ('Card #' + u.id)) + '</div><div class="t">#' + u.id + ' · ' + esc(u.message) + '</div></div><span class="x">×' + u.copies + '</span></div>').join('');
  $('noticeModal').classList.add('on');
}
$('ntOk').onclick = () => $('noticeModal').classList.remove('on');
function rename() { const d = decks.find(x => x.id === sel); $('rnName').value = d ? d.name : ''; $('renameModal').classList.add('on'); }
$('rnCancel').onclick = () => $('renameModal').classList.remove('on');
$('rnGo').onclick = async () => {
  try { await api('/api/decks/' + sel, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ name: $('rnName').value }) });
    $('renameModal').classList.remove('on'); await load(); showDetail(sel); } catch (e) { toast(e.message, true); }
};
async function del() {
  const d = decks.find(x => x.id === sel); if (!d || !confirm('Delete "' + d.name + '" permanently?')) return;
  try { await api('/api/decks/' + sel, { method: 'DELETE' }); sel = null; $('detail').innerHTML = '<p class="sub">Select a deck to see its cards.</p>'; await load(); toast('Deck deleted'); }
  catch (e) { toast(e.message, true); }
}
$('upCancel').onclick = () => $('uploadModal').classList.remove('on');
$('upGo').onclick = async () => {
  const f = $('upFile').files[0]; if (!f) return toast('Choose a .ydk file first', true);
  if (f.size > 200000) return toast('That file is too large for a deck.', true);
  $('upGo').disabled = true; $('upGo').textContent = 'Uploading…';
  try {
    const text = await f.text(), name = $('upName').value.trim() || f.name.replace(/\.ydk$/i, '');
    const r = await api('/api/decks/import', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ text, name, mode: $('upMode').value }) });
    $('uploadModal').classList.remove('on'); sel = r.id; toast(r.message, !r.deck.valid); await load(); showDetail(sel);
    const list = [...r.skipped.map(id => ({ id, message: 'unknown to the engine', copies: 1 })), ...r.dropped.map(c => ({ id: c.id, name: c.name, message: 'not allowed in Classic', copies: 1 }))];
    if (list.length) notice('Deck added — but some cards were left out', r.message, list);
  } catch (e) {
    toast(e.message, true);
  } finally { $('upGo').disabled = false; $('upGo').textContent = 'Upload'; }
};
load().then(() => { if (location.hash === '#upload') $('uploadModal').classList.add('on'); });
</script>
</div></body></html>
